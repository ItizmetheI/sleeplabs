---
// Scorecard (owner template): lead with the model count and as-of month, one table sorted by
// Overall then the tie order (AS3 first), "How scores work", and the /scores.csv download.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { allMattresses } from '../../data/mattresses';
import { toArticleBody, articleTable } from '../../lib/schemaArticleBody';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { SCORECARD_HEADERS, scorecardAsOf, scorecardRows } from '../../lib/scorecard';
import { h1For, reviewUrl } from '../../lib/ownerSite';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const DATE_MODIFIED = '2026-10-12';
const pageUrl = '/reviews/';
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);
const rows = scorecardRows();
const brandCount = new Set(allMattresses.map(m => m.brand)).size;
const asOf = scorecardAsOf();

const lead = `This scorecard rates ${rows.length} mattresses from ${brandCount} brands on seven fields, with specs as of ${asOf}. It is sorted by Overall score, and each name links to its full review.`;
const howScoresPlain = 'Each model gets a score from 0 to 10 in Value, Edge Support, Trial Period, Response Time, Motion Transfer and Cooling & Breathability. Overall is the average of those six, shown to one decimal. When Overall scores tie, the table keeps the same order used across the site. Our methodology explains what earns a 10 in each field.';
const description = `Scores for ${rows.length} mattresses from ${brandCount} brands on seven fields, sorted by Overall, with firmness, type, trial and warranty. Download the full table as CSV.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#page`,
      "name": h1,
      "description": description,
      "url": canonicalUrl,
      "datePublished": DATE_MODIFIED,
      "dateModified": DATE_MODIFIED,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "text": toArticleBody(h1, BYLINE_DISCLOSURE, lead, articleTable('Scorecard', [...SCORECARD_HEADERS], rows.map(r => r.cells)), "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.", 'How Scores Work', howScoresPlain),
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": rows.map((r, i) => ({ "@type": "ListItem", "position": i + 1, "name": r.mattress.name, "url": `${SITE_URL}${reviewUrl(r.mattress.id)}` })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": h1, "item": canonicalUrl },
      ],
    },
  ],
};

const th = 'text-left px-3 py-3 font-bold text-on-surface bg-surface-container-low whitespace-nowrap';
const td = 'px-3 py-3 text-on-surface-variant border-t border-outline-variant/30 align-top';
const h2 = 'text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3';
// Numeric columns sort high to low first; text columns sort A to Z.
const numericCols = new Set([1, 2, 3, 4, 5, 6, 7]);
---

<BaseLayout
  title={`${h1}: ${rows.length} Models Scored`}
  description={description}
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/reviews.md`}
  lastUpdated={DATE_MODIFIED}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full">
    <article class="flex flex-col gap-8" data-body data-page-type="scorecard">
      <header class="flex flex-col gap-4 max-w-3xl">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={DATE_MODIFIED} />
        <p class="text-body-lg text-on-surface leading-relaxed">{lead}</p>
        <p class="text-body-md"><a href="/scores.csv" class="text-primary underline underline-offset-4 font-bold" download>Download the scorecard as CSV</a></p>
      </header>

      <section class="flex flex-col gap-3" data-section="Scorecard" data-score-table>
        <div class="w-full overflow-x-auto border border-outline-variant/40 rounded-lg" tabindex="0" role="region" aria-label="Scorecard table, scrolls sideways">
          <table class="w-full text-body-sm" data-sortable>
            <caption class="sr-only">Mattress scores, sorted by Overall. Select a column heading to sort by it.</caption>
            <thead>
              <tr>
                {SCORECARD_HEADERS.map((h, i) => (
                  <th scope="col" class={th} aria-sort={i === 1 ? 'descending' : 'none'}>
                    <button type="button" class="font-bold text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary rounded" data-col={i} data-numeric={numericCols.has(i) ? '1' : undefined}>{h}</button>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((r, idx) => (
                <tr data-rank={idx}>
                  <th scope="row" class={`${td} font-normal`}>
                    <a href={reviewUrl(r.mattress.id)} class="flex items-center gap-3 min-w-[200px]">
                      <img src={r.mattress.image} alt="" class="w-14 h-10 object-contain bg-white rounded shrink-0" loading="lazy" />
                      <span class="text-primary underline underline-offset-4 font-bold">{r.mattress.name}</span>
                    </a>
                  </th>
                  {r.cells.slice(1).map((c, i) => <td class={td} data-overall={i === 0 ? '' : undefined}>{c}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-body-sm text-on-surface-variant" data-score-line>Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.</p>
      </section>

      <section class="flex flex-col gap-3 max-w-3xl" data-section="How Scores Work">
        <h2 class={h2}>How Scores Work</h2>
        <p class="text-body-md text-on-surface-variant leading-relaxed">
          Each model gets a score from 0 to 10 in Value, Edge Support, Trial Period, Response Time, Motion Transfer and Cooling &amp; Breathability. Overall is the average of those six, shown to one decimal. When Overall scores tie, the table keeps the same order used across the site. Our <a href="/methodology/" class="text-primary underline underline-offset-4">methodology</a> explains what earns a 10 in each field.
        </p>
      </section>
    </article>
  </main>
</BaseLayout>

<script>
  // Column sort. Selecting the active column again reverses it; ties keep the scorecard order.
  const table = document.querySelector<HTMLTableElement>('table[data-sortable]');
  if (table) {
    const tbody = table.tBodies[0];
    const headers = [...table.querySelectorAll<HTMLTableCellElement>('thead th')];
    table.querySelectorAll<HTMLButtonElement>('thead button').forEach(btn => {
      btn.addEventListener('click', () => {
        const col = Number(btn.dataset.col);
        const th = headers[col];
        const numeric = btn.dataset.numeric === '1';
        const current = th.getAttribute('aria-sort');
        const first = numeric ? 'descending' : 'ascending';
        const dir = current === first ? (first === 'ascending' ? 'descending' : 'ascending') : first;
        const sign = dir === 'ascending' ? 1 : -1;
        const value = (row: HTMLTableRowElement) => row.cells[col].textContent?.trim() ?? '';
        const rows = [...tbody.rows].sort((a, b) => {
          const va = value(a), vb = value(b);
          const cmp = numeric ? Number(va) - Number(vb) : va.localeCompare(vb);
          return cmp * sign || Number(a.dataset.rank) - Number(b.dataset.rank);
        });
        rows.forEach(r => tbody.appendChild(r));
        headers.forEach(h => h.setAttribute('aria-sort', 'none'));
        th.setAttribute('aria-sort', dir);
      });
    });
  }
</script>
