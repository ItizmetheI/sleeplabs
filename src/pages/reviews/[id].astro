---
// Review template (owner content instructions): 14 sections in fixed order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import PriceCta from '../../components/PriceCta.astro';
import Prose from '../../components/Prose.astro';
import { allMattresses } from '../../data/mattresses';
import { REVIEW_COPY } from '../../content/reviews';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody, articleList, articleTable } from '../../lib/schemaArticleBody';
import { FIELD_LABEL, SIX_FIELDS } from '../../lib/ranking';
import { alternativesFor, getSpec, reviewSeoTitle, reviewSpecRows, scoreText } from '../../lib/pageData';
import {
  h1For, renderInline, plainInline, assertAllowedLink, reviewUrl,
  firmnessText, firmnessShort, heightText, typeText, trialText, warrantyText, queenPriceText,
  listOrNotListed, plainOrNotListed,
} from '../../lib/ownerSite';

export function getStaticPaths() {
  // MI_ONLY limits a local QA build to listed slugs while copy is in progress; release builds never set it.
  const only = process.env.MI_ONLY?.split(',');
  return allMattresses
    .filter(m => !only || only.includes(m.id))
    .map(m => ({ params: { id: m.id }, props: { mattress: m } }));
}

const { mattress } = Astro.props;
const copy = REVIEW_COPY[mattress.id];
if (!copy) throw new Error(`Missing review copy for ${mattress.id}`);

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const pageUrl = reviewUrl(mattress.id);
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);
const spec = getSpec(mattress.id);
const ctx = `review ${mattress.id}`;
const alternatives = alternativesFor(mattress.id);
const heroImage = mattress.heroImage.startsWith('http') ? mattress.heroImage : `${SITE_URL}${mattress.heroImage}`;

const specRows = reviewSpecRows(spec);

if (spec.layers.length && copy.layerRoles.length !== spec.layers.length) {
  throw new Error(`${ctx}: ${copy.layerRoles.length} layer roles for ${spec.layers.length} spec layers.`);
}
const layerRows = spec.layers.map((layer, i) => [String(i + 1), layer.thickness === 'not listed' ? 'Not listed' : `${layer.thickness} in`, layer.name, copy.layerRoles[i]]);

const positionNames = { side: 'Side Sleepers', back: 'Back Sleepers', stomach: 'Stomach Sleepers', combination: 'Combination Sleepers' } as const;
const weightLabels = [['under130', 'Under 130 lb'], ['from130to230', '130 to 230 lb'], ['over230', 'Over 230 lb']] as const;

const compareRows = [mattress, ...alternatives].map(m => {
  const s = getSpec(m.id);
  return { m, cells: [`${scoreText(m, 'overall')}/10`, typeText(s), firmnessShort(s), trialText(s), warrantyText(s)] };
});

copy.related.forEach(link => assertAllowedLink(link.href, `${ctx} related`));
if (copy.faqs.length < 5 || copy.faqs.length > 8) throw new Error(`${ctx}: needs 5 to 8 FAQs.`);

const plain = (items: string[]) => items.map(plainInline);
const articleBody = toArticleBody(
  h1,
  BYLINE_DISCLOSURE,
  'Quick Answer', plainInline(copy.quickAnswer),
  articleTable('Scorecard', ['Field', 'Score'], [
    ['Overall', `${scoreText(mattress, 'overall')}/10`],
    ...SIX_FIELDS.map(k => [FIELD_LABEL[k], `${scoreText(mattress, k)}/10`]),
    ['Firmness', firmnessShort(spec)],
  ]),
  "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.",
  articleTable('Specs at a Glance', ['Spec', 'Detail'], specRows),
  'Strengths and Limitations',
  articleList('Strengths', plain(copy.strengths)),
  articleList('Limitations', plain(copy.limitations)),
  'How It Was Scored', plainInline(copy.howScored),
  'Construction',
  articleTable('Layers', ['Layer', 'Thickness', 'Material', 'What it does'], layerRows),
  plain(copy.construction),
  'Performance',
  SIX_FIELDS.map(k => [`${FIELD_LABEL[k]}: ${scoreText(mattress, k)}/10`, plain(copy.performance[k as keyof typeof copy.performance])]),
  'Firmness and Feel by Sleep Position', plainInline(copy.positionsIntro),
  (Object.keys(positionNames) as (keyof typeof positionNames)[]).map(p => [
    positionNames[p],
    weightLabels.map(([key, label]) => `${label}: ${plainInline(copy.positions[p][key])}`),
  ]),
  'Who Should Buy It / Who Should Skip It',
  articleList('Who Should Buy It', plain(copy.buy)),
  articleList('Who Should Skip It', plain(copy.skip)),
  'How It Compares', plainInline(copy.compareIntro),
  articleTable('Comparison', ['Mattress', 'Overall', 'Type', 'Firmness', 'Trial', 'Warranty'], compareRows.map(r => [r.m.name, ...r.cells])),
  'Trial, Warranty, Shipping and Returns', plain(copy.policies),
  'FAQs', copy.faqs.map(f => [f.q, plainInline(f.a)]),
  'Verdict', plainInline(copy.verdict),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": h1,
      "description": copy.metaDescription,
      "articleBody": articleBody,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "datePublished": mattress.dateReviewed,
      "dateModified": copy.dateModified,
      "image": heroImage,
      "mainEntityOfPage": canonicalUrl,
      "about": { "@id": `${canonicalUrl}#product` }
    },
    {
      "@type": "Product",
      "@id": `${canonicalUrl}#product`,
      "name": mattress.name,
      "brand": { "@type": "Brand", "name": mattress.brand },
      "image": heroImage,
      "url": canonicalUrl,
      "review": {
        "@type": "Review",
        "@id": `${canonicalUrl}#review`,
        "reviewRating": { "@type": "Rating", "ratingValue": scoreText(mattress, 'overall'), "bestRating": "10" },
        "author": { "@type": "Organization", "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
        "reviewBody": plainInline(copy.verdict)
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Mattress Reviews and Scores (2026)", "item": `${SITE_URL}/reviews/` },
        { "@type": "ListItem", "position": 3, "name": h1, "item": canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": copy.faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": plainInline(f.a) } }))
    }
  ]
};

const h2 = 'text-headline-md font-headline-md text-primary italic border-b border-outline-variant/30 pb-4';
const h3 = 'text-title-lg font-bold text-on-surface';
const tableWrap = 'w-full overflow-x-auto border border-outline-variant/40 rounded-lg';
const th = 'text-left px-4 py-3 font-bold text-on-surface bg-surface-container-low';
const td = 'px-4 py-3 text-on-surface-variant border-t border-outline-variant/30 align-top';
---

<BaseLayout
  title={reviewSeoTitle(mattress)}
  description={copy.metaDescription}
  ogType="article"
  ogImage={mattress.heroImage}
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/reviews-${mattress.id}.md`}
  lastUpdated={copy.dateModified}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-12">
    <header class="flex flex-col gap-6 items-center text-center max-w-4xl mx-auto">
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
      <Byline dateModified={copy.dateModified} />
    </header>

    <!-- Hero Image -->
    <div class="w-full h-[300px] md:h-[520px] rounded-lg overflow-hidden shadow-lg relative border border-outline-variant bg-white">
      <img src={mattress.heroImage} alt={`${mattress.name} product image`} class="w-full h-full object-contain" loading="eager" />
    </div>

    <div class="flex flex-col lg:flex-row gap-12 items-start">
    <article class="flex-1 min-w-0 flex flex-col gap-12 w-full" data-body data-page-type="review">

      <section class="flex flex-col gap-3" data-section="Quick Answer">
        <h2 class={h2}>Quick Answer</h2>
        <p class="text-body-lg text-on-surface leading-relaxed" set:html={renderInline(copy.quickAnswer, ctx)} />
      </section>

      <ScoreCard mattress={mattress} pageUrl={pageUrl} showScoreLine />

      <section class="flex flex-col gap-3" data-section="Specs at a Glance">
        <h2 class={h2}>Specs at a Glance</h2>
        <div class={tableWrap}>
          <table class="w-full text-body-md">
            <caption class="sr-only">{mattress.name} specs from the official brand page</caption>
            <tbody>
              {specRows.map(([label, value]) => (
                <tr><th scope="row" class={`${th} w-[38%]`}>{label}</th><td class={td}>{value}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-4" data-section="Strengths and Limitations">
        <h2 class={h2}>Strengths and Limitations</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="glass-panel p-6 rounded-lg border border-green-200/50">
            <h3 class="text-label-sm font-label-sm uppercase tracking-normal text-green-700 font-bold mb-4">Strengths</h3>
            <ul class="list-disc pl-5 flex flex-col gap-2 text-body-md text-on-surface-variant">
              {copy.strengths.map(item => <li set:html={renderInline(item, ctx)} />)}
            </ul>
          </div>
          <div class="glass-panel p-6 rounded-lg border border-red-200/50">
            <h3 class="text-label-sm font-label-sm uppercase tracking-normal text-red-600 font-bold mb-4">Limitations</h3>
            <ul class="list-disc pl-5 flex flex-col gap-2 text-body-md text-on-surface-variant">
              {copy.limitations.map(item => <li set:html={renderInline(item, ctx)} />)}
            </ul>
          </div>
        </div>
      </section>

      <section class="glass-panel p-8 rounded-lg border border-white/60 flex flex-col gap-3" data-section="How It Was Scored">
        <h2 class={h2}>How It Was Scored</h2>
        <Prose paragraphs={[copy.howScored]} context={ctx} />
      </section>

      <section class="flex flex-col gap-4" data-section="Construction">
        <h2 class={h2}>Construction</h2>
        {layerRows.length > 0 && (
          <div class={tableWrap}>
            <table class="w-full text-body-md">
              <caption class="sr-only">{mattress.name} layers, top to bottom, as listed on the brand page</caption>
              <thead><tr><th scope="col" class={th}>Layer</th><th scope="col" class={th}>Thickness</th><th scope="col" class={th}>Material</th><th scope="col" class={th}>What it does</th></tr></thead>
              <tbody>
                {layerRows.map(row => <tr>{row.map(cell => <td class={td}>{cell}</td>)}</tr>)}
              </tbody>
            </table>
          </div>
        )}
        <Prose paragraphs={copy.construction} context={ctx} />
      </section>

      <section class="flex flex-col gap-5" data-section="Performance">
        <h2 class={h2}>Performance</h2>
        {SIX_FIELDS.map(key => (
          <div class="flex flex-col gap-2">
            <h3 class={h3}>{FIELD_LABEL[key]}: {scoreText(mattress, key)}/10</h3>
            <Prose paragraphs={copy.performance[key as keyof typeof copy.performance]} context={ctx} />
          </div>
        ))}
      </section>

      <section class="flex flex-col gap-5" data-section="Firmness and Feel by Sleep Position">
        <h2 class={h2}>Firmness and Feel by Sleep Position</h2>
        <Prose paragraphs={[copy.positionsIntro]} context={ctx} />
        {(Object.keys(positionNames) as (keyof typeof positionNames)[]).map(p => (
          <div class="flex flex-col gap-2">
            <h3 class={h3}>{positionNames[p]}</h3>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
              {weightLabels.map(([key, label]) => <li><strong class="text-on-surface">{label}:</strong> <span set:html={renderInline(copy.positions[p][key], ctx)} /></li>)}
            </ul>
          </div>
        ))}
      </section>

      <section class="flex flex-col gap-4" data-section="Who Should Buy It / Who Should Skip It">
        <h2 class={h2}>Who Should Buy It / Who Should Skip It</h2>
        <h3 class={h3}>Who Should Buy It</h3>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
          {copy.buy.map(item => <li set:html={renderInline(item, ctx)} />)}
        </ul>
        <h3 class={h3}>Who Should Skip It</h3>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
          {copy.skip.map(item => <li set:html={renderInline(item, ctx)} />)}
        </ul>
      </section>

      <section class="flex flex-col gap-4" data-section="How It Compares">
        <h2 class={h2}>How It Compares</h2>
        <Prose paragraphs={[copy.compareIntro]} context={ctx} />
        <div class={tableWrap}>
          <table class="w-full text-body-md">
            <caption class="sr-only">{mattress.name} compared with similar mattresses on this site</caption>
            <thead><tr>{['Mattress', 'Overall', 'Type', 'Firmness', 'Trial', 'Warranty'].map(h => <th scope="col" class={th}>{h}</th>)}</tr></thead>
            <tbody>
              {compareRows.map(r => (
                <tr>
                  <td class={td}>{r.m.id === mattress.id ? <strong class="text-on-surface">{r.m.name}</strong> : <a href={reviewUrl(r.m.id)} class="text-primary underline underline-offset-4">{r.m.name}</a>}</td>
                  {r.cells.map(cell => <td class={td}>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-3" data-section="Trial, Warranty, Shipping and Returns">
        <h2 class={h2}>Trial, Warranty, Shipping and Returns</h2>
        <Prose paragraphs={copy.policies} context={ctx} />
      </section>

      <section class="flex flex-col gap-4" data-section="FAQs">
        <h2 class={h2}>FAQs</h2>
        {copy.faqs.map(f => (
          <div class="glass-panel p-6 rounded-lg border border-outline-variant/30 flex flex-col gap-2">
            <h3 class={h3}>{f.q}</h3>
            <p class="text-body-md text-on-surface-variant leading-relaxed" set:html={renderInline(f.a, ctx)} />
          </div>
        ))}
      </section>

      <section class="glass-panel-heavy p-8 rounded-lg border border-secondary/20 flex flex-col gap-4" data-section="Verdict">
        <h2 class={h2}>Verdict</h2>
        <Prose paragraphs={[copy.verdict]} context={ctx} />
        <div><PriceCta mattress={mattress} pageUrl={pageUrl} /></div>
      </section>

      <section class="flex flex-col gap-3" data-section="Related">
        <h2 class={h2}>Related</h2>
        <ul class="flex flex-col gap-2 text-body-md">
          {copy.related.map(link => <li><a href={link.href} class="text-primary underline underline-offset-4 font-bold">{link.label}</a></li>)}
        </ul>
      </section>
    </article>

    <!-- Sidebar Scorecard -->
    <aside class="w-full lg:w-[360px] shrink-0 lg:sticky lg:top-[100px]">
      <div class="glass-panel-heavy p-8 rounded-lg border border-white/60 shadow-xl flex flex-col gap-8">
        <div class="flex flex-col items-center justify-center pt-2 pb-6 border-b border-outline-variant/30">
          <span class="text-label-sm font-label-sm uppercase tracking-normal text-secondary font-bold mb-2">Overall Score</span>
          <div class="flex items-baseline justify-center gap-2 leading-none">
            <span class="text-[64px] sm:text-[80px] font-headline-lg font-bold italic text-primary" data-overall>{scoreText(mattress, 'overall')}</span>
            <span class="text-title-md text-on-surface-variant font-normal">/10</span>
          </div>
        </div>
        <div class="flex flex-col gap-6">
          {SIX_FIELDS.map(key => (
            <div class="flex flex-col gap-2">
              <div class="flex justify-between items-center text-body-md">
                <span class="text-on-surface font-bold">{FIELD_LABEL[key]}</span>
                <span class="text-primary font-bold">{scoreText(mattress, key)}</span>
              </div>
              <div class="w-full bg-outline-variant/20 h-2.5 rounded-full overflow-hidden" role="img" aria-label={`${FIELD_LABEL[key]}: ${scoreText(mattress, key)} out of 10`}>
                <div class="bg-secondary h-full rounded-full" style={`width: ${mattress.scores[key] * 10}%`}></div>
              </div>
            </div>
          ))}
        </div>
        <div class="pt-6 border-t border-outline-variant/30 flex flex-col gap-3 [&>a]:w-full [&>a]:text-center">
          <PriceCta mattress={mattress} pageUrl={pageUrl} />
          <a href="/methodology/" class="text-body-sm text-secondary underline underline-offset-4 font-bold">How we score</a>
        </div>
      </div>
    </aside>
    </div>
  </main>
</BaseLayout>
