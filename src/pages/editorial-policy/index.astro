---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody, articleList } from '../../lib/schemaArticleBody';
import { MODEL_COUNT } from '../../lib/methodologyContent';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const lastUpdated = "2026-10-11";
const canonicalUrl = `${SITE_URL}/editorial-policy/`;
const description = 'Mattress Inquirer editorial standards: one scorecard for every brand, no medical claims, specs from official brand pages, and how corrections work.';

const lead = 'Mattress Inquirer holds every brand to the same standards. This page explains how pages are written and how corrections are handled.';
const standards = [
  { title: 'One scorecard for every brand.', body: `All ${MODEL_COUNT} mattresses are scored on the same seven fields and the same 0 to 10 scale.` },
  { title: 'No medical claims.', body: 'A mattress is a comfort choice. Pages describe support and feel, not health outcomes.' },
  { title: 'Specs from brand pages.', body: 'Construction, firmness, trial, warranty, and price come from each brand\'s official product page. A fact the brand does not state is left out, not estimated.' },
  { title: 'Scores from the scorecard.', body: 'Scores are editorial ratings set from each model\'s construction, policies, and price. A score never changes to move a product up or down a list.' },
  { title: 'Dated prices.', body: 'Every price shows the month it was checked. Confirm the current price on the brand\'s site before buying.' },
];
const corrections = [
  'When a brand changes a product, price, or policy, the page is corrected to match the brand\'s official page.',
  'The updated date on a page changes only when its content changes. Send corrections to contact@mattressinquirer.com.',
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Editorial Policy",
      "url": canonicalUrl,
      "description": description,
      "text": toArticleBody(
        'Editorial Policy',
        BYLINE_DISCLOSURE,
        lead,
        articleList('Our Standards', standards.map(item => `${item.title} ${item.body}`)),
        'Corrections',
        corrections,
      ),
      "dateModified": lastUpdated,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team" },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Editorial Policy", "item": canonicalUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title="Editorial Policy | Mattress Inquirer"
  description={description}
  canonicalUrl={canonicalUrl}
  lastUpdated={lastUpdated}
  jsonLd={jsonLd}
>
  <main class="max-w-[760px] mx-auto px-margin-mobile md:px-0 py-16 relative z-10 flex flex-col gap-12">
    <article class="contents" data-body data-page-type="editorial-policy">

    <header class="flex flex-col gap-6">
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold">Editorial Policy</h1>
      <Byline dateModified={lastUpdated} />
      <p class="text-body-lg text-on-surface-variant leading-relaxed">{lead}</p>
    </header>

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">Our Standards</h2>
      <ul class="flex flex-col gap-3 text-body-md text-on-surface-variant list-disc pl-5">
        {standards.map(item => (
          <li><strong class="text-on-surface">{item.title}</strong> {item.body}</li>
        ))}
      </ul>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">Corrections</h2>
      {corrections.map(paragraph => (
        <p class="text-body-md text-on-surface-variant leading-relaxed">{paragraph}</p>
      ))}
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">Related</h2>
      <ul class="flex flex-col gap-2 text-body-md">
        <li><a href="/methodology/" class="text-primary underline underline-offset-4 font-bold">How Mattress Inquirer Scores Mattresses</a></li>
        <li><a href="/about/" class="text-primary underline underline-offset-4 font-bold">About Mattress Inquirer</a></li>
        <li><a href="/affiliate-disclosure/" class="text-primary underline underline-offset-4 font-bold">Affiliate Disclosure</a></li>
      </ul>
    </section>

  </article>
  </main>
</BaseLayout>
