---
// Best-of template (owner content instructions): ranked by the owner's ranking-rule table via
// rankBestPage, with the Amerisleep AS3 rule, awards, and the fixed section order.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import ScoreCard from '../../components/ScoreCard.astro';
import PriceCta from '../../components/PriceCta.astro';
import Prose from '../../components/Prose.astro';
import { BEST_COPY } from '../../content/best';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody, articleList, articleTable } from '../../lib/schemaArticleBody';
import { BEST_PAGE_CONFIGS, FIELD_LABEL, rankBestPage, SIX_FIELDS } from '../../lib/ranking';
import { AS3_ID } from '../../lib/scoreFieldOrder';
import { as3RankingSentence, bestSeoTitle, getMattress, getSpec, scoreText } from '../../lib/pageData';
import {
  h1For, renderInline, plainInline, assertAllowedLink, reviewUrl, qualifyingFirmnessText, firmnessShort,
  heightText, typeText, trialText, warrantyText, queenPriceText, queenPriceLabel,
  COMFORT_NOT_TREATMENT, PAIN_PAGE_SLUGS,
} from '../../lib/ownerSite';

export function getStaticPaths() {
  // MI_BEST limits a local QA build to listed slugs while copy is in progress; release builds never set it.
  const only = process.env.MI_BEST?.split(',');
  return BEST_PAGE_CONFIGS
    .filter(c => !only || only.includes(c.slug))
    .map(config => ({ params: { category: config.slug }, props: { config } }));
}

const { config } = Astro.props;
const copy = BEST_COPY[config.slug];
if (!copy) throw new Error(`Missing best-of copy for ${config.slug}`);

const result = rankBestPage(config);
if (result.skip) throw new Error(`/best/${config.slug}/ has ${result.qualifierCount} qualifiers; the owner rule says SKIP.`);
const picks = result.picks;
if (copy.picks.length !== picks.length || copy.picks.some((p, i) => p.slug !== picks[i].candidate.mattress.id)) {
  throw new Error(`/best/${config.slug}/ copy picks [${copy.picks.map(p => p.slug).join(', ')}] do not match the ranked order [${picks.map(p => p.candidate.mattress.id).join(', ')}].`);
}
if (!result.as3Qualifies && !copy.as3BoxReason) throw new Error(`/best/${config.slug}/ needs the AS3 box sentence.`);
if (copy.faqs.length < 5 || copy.faqs.length > 8) throw new Error(`/best/${config.slug}/ needs 5 to 8 FAQs.`);

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const pageUrl = `/best/${config.slug}/`;
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);
const ctx = `best ${config.slug}`;
const as3 = getMattress(AS3_ID);
const showPrice = config.row === 'luxury' || config.row === 'under-1000';
const isPainPage = PAIN_PAGE_SLUGS.has(config.slug);
copy.related.forEach(link => assertAllowedLink(link.href, `${ctx} related`));

// How We Picked opens with the owner's fixed AS3 sentence and the ranking rule in plain words.
const as3Sentence = as3RankingSentence(config, result);
const howWePicked = [as3Sentence, ...copy.howWePicked, ...(isPainPage ? [COMFORT_NOT_TREATMENT] : [])];

const pickRows = picks.map(p => {
  const m = p.candidate.mattress;
  const spec = p.candidate.spec;
  const firmness = qualifyingFirmnessText(spec, p.candidate.qualifyingFirmness);
  const mini: [string, string][] = [
    ['Type', typeText(spec)],
    ['Firmness', firmness],
    ['Height', heightText(spec)],
    ['Trial', trialText(spec)],
    ['Warranty', warrantyText(spec)],
    ...(showPrice ? [[queenPriceLabel(spec), queenPriceText(spec)] as [string, string]] : []),
  ];
  const glanceFirmness = p.candidate.qualifyingFirmness
    ? `${p.candidate.qualifyingFirmness.display}/10, ${p.candidate.qualifyingFirmness.label} option`
    : firmnessShort(spec);
  return { pick: p, m, spec, firmness, glanceFirmness, mini, copy: copy.picks[p.rank - 1] };
});

const plain = (items: string[]) => items.map(plainInline);
const articleBody = toArticleBody(
  h1,
  BYLINE_DISCLOSURE,
  plainInline(copy.quickAnswer),
  ...(result.as3Qualifies ? [] : [`Our Best Overall Pick: Amerisleep AS3 (${scoreText(as3, 'overall')}/10). ${plainInline(copy.as3BoxReason!)}`]),
  articleTable('Our Picks at a Glance', ['Rank', 'Mattress', 'Award', 'Overall', 'Firmness', 'Type', 'Trial', 'Warranty'],
    pickRows.map(r => [String(r.pick.rank), r.m.name, r.pick.award, `${scoreText(r.m, 'overall')}/10`, r.glanceFirmness, typeText(r.spec), trialText(r.spec), warrantyText(r.spec)])),
  'How We Picked', plain(howWePicked),
  pickRows.map((r, i) => [
    `#${r.pick.rank} ${r.pick.award}: ${r.m.name}`,
    articleTable('Scorecard', ['Field', 'Score'], [
      ['Overall', `${scoreText(r.m, 'overall')}/10`],
      ...SIX_FIELDS.map(k => [FIELD_LABEL[k], `${scoreText(r.m, k)}/10`]),
    ]),
    ...(i === 0 ? ["Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale."] : []),
    plain(r.copy.why),
    articleTable('Specs', ['Spec', 'Detail'], r.mini),
    articleList('Strengths', plain(r.copy.strengths)),
    articleList('Limitations', plain(r.copy.limitations)),
  ]),
  copy.whatMattersHeading, plain(copy.whatMatters),
  'FAQs', copy.faqs.map(f => [f.q, plainInline(f.a)]),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": h1,
      "description": copy.metaDescription,
      "articleBody": articleBody,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "datePublished": copy.dateModified,
      "dateModified": copy.dateModified,
      "mainEntityOfPage": canonicalUrl,
      "about": { "@id": `${canonicalUrl}#list` }
    },
    {
      "@type": "ItemList",
      "@id": `${canonicalUrl}#list`,
      "name": h1,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "numberOfItems": picks.length,
      "itemListElement": pickRows.map(r => ({ "@type": "ListItem", "position": r.pick.rank, "name": r.m.name, "url": `${SITE_URL}${reviewUrl(r.m.id)}` }))
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": h1, "item": canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": copy.faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": plainInline(f.a) } }))
    }
  ]
};

const h2 = 'text-headline-md font-headline-md text-primary italic border-b border-outline-variant/30 pb-4';
const h3 = 'text-title-lg font-bold text-on-surface';
const tableWrap = 'w-full overflow-x-auto border border-outline-variant/40 rounded-lg';
const th = 'text-left px-4 py-3 font-bold text-on-surface bg-surface-container-low';
const td = 'px-4 py-3 text-on-surface-variant border-t border-outline-variant/30 align-top';
---

<BaseLayout
  title={bestSeoTitle(h1, picks.length)}
  description={copy.metaDescription}
  ogType="article"
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/best-${config.slug}.md`}
  lastUpdated={copy.dateModified}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-14">
    <article class="flex flex-col gap-10" data-body data-page-type="best-of">
      <header class="flex flex-col gap-6 max-w-4xl">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={copy.dateModified} />
        <p class="text-body-lg text-on-surface leading-relaxed" data-quick-answer set:html={renderInline(copy.quickAnswer, ctx)} />
        <a href={reviewUrl(picks[0].candidate.mattress.id)} class="block glass-panel rounded-lg border border-outline-variant/40 overflow-hidden">
          <img src={picks[0].candidate.mattress.heroImage || picks[0].candidate.mattress.image} alt={`${picks[0].candidate.mattress.name} mattress`} class="w-full h-56 md:h-72 object-contain bg-white p-3" loading="eager" />
        </a>
      </header>

      {!result.as3Qualifies && (
        <aside class="border-2 border-primary rounded-lg bg-surface-container-low p-6 flex flex-col sm:flex-row gap-5 sm:items-center" data-as3-box>
          <img src={as3.image} alt="Amerisleep AS3 mattress" class="w-full sm:w-40 h-28 object-contain bg-white rounded-lg p-2 shrink-0" loading="lazy" />
          <div class="flex flex-col gap-2">
          <p class="text-title-lg font-bold text-primary">Our Best Overall Pick: Amerisleep AS3 ({scoreText(as3, 'overall')}/10)</p>
          <p class="text-body-md text-on-surface-variant" set:html={renderInline(copy.as3BoxReason!, ctx)} />
          <p><a href={reviewUrl(AS3_ID)} class="text-primary underline underline-offset-4 font-bold">Read the Amerisleep AS3 review</a></p>
          </div>
        </aside>
      )}

      <section class="flex flex-col gap-3" data-section="Our Picks at a Glance">
        <h2 class={h2}>Our Picks at a Glance</h2>
        <div class={tableWrap}>
          <table class="w-full text-body-md">
            <caption class="sr-only">{h1}: ranked picks</caption>
            <thead><tr>{['Rank', 'Mattress', 'Award', 'Overall', 'Firmness', 'Type', 'Trial', 'Warranty'].map(h => <th scope="col" class={th}>{h}</th>)}</tr></thead>
            <tbody>
              {pickRows.map(r => (
                <tr>
                  <td class={td}>{r.pick.rank}</td>
                  <td class={td}><a href={reviewUrl(r.m.id)} class="text-primary underline underline-offset-4">{r.m.name}</a></td>
                  <td class={td}>{r.pick.award}</td>
                  <td class={td}>{scoreText(r.m, 'overall')}/10</td>
                  <td class={td}>{r.glanceFirmness}</td>
                  <td class={td}>{typeText(r.spec)}</td>
                  <td class={td}>{trialText(r.spec)}</td>
                  <td class={td}>{warrantyText(r.spec)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-3" data-section="How We Picked">
        <h2 class={h2}>How We Picked</h2>
        <Prose paragraphs={howWePicked} context={ctx} />
      </section>

      {pickRows.map((r, i) => (
        <section class="flex flex-col gap-4" data-section="Pick" data-pick={r.m.id}>
          <h2 class={h2}>#{r.pick.rank} {r.pick.award}: {r.m.name}</h2>
          <a href={reviewUrl(r.m.id)} class="block glass-panel rounded-lg border border-outline-variant/40 overflow-hidden">
            <img src={r.m.image} alt={`${r.m.name} mattress`} class="w-full h-48 md:h-56 object-contain bg-white p-3" loading={i === 0 ? 'eager' : 'lazy'} />
          </a>
          <ScoreCard mattress={r.m} pageUrl={pageUrl} showScoreLine={i === 0} firmnessOverride={r.glanceFirmness} showCta={false} />
          <div class="flex flex-col gap-3" data-why><Prose paragraphs={r.copy.why} context={ctx} /></div>
          <div class={tableWrap}>
            <table class="w-full text-body-md">
              <caption class="sr-only">{r.m.name} specs from the official brand page</caption>
              <tbody>
                {r.mini.map(([label, value]) => <tr><th scope="row" class={`${th} w-[38%]`}>{label}</th><td class={td}>{value}</td></tr>)}
              </tbody>
            </table>
          </div>
          <div class="grid md:grid-cols-2 gap-4" data-proscons>
            <div>
              <h3 class={h3}>Strengths</h3>
              <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
                {r.copy.strengths.map(item => <li set:html={renderInline(item, ctx)} />)}
              </ul>
            </div>
            <div>
              <h3 class={h3}>Limitations</h3>
              <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
                {r.copy.limitations.map(item => <li set:html={renderInline(item, ctx)} />)}
              </ul>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a href={reviewUrl(r.m.id)} class="text-primary underline underline-offset-4 font-bold">Read the full review</a>
            <PriceCta mattress={r.m} pageUrl={pageUrl} />
          </div>
        </section>
      ))}

      <section class="flex flex-col gap-3" data-section="What Matters">
        <h2 class={h2}>{copy.whatMattersHeading}</h2>
        <Prose paragraphs={copy.whatMatters} context={ctx} />
      </section>

      <section class="flex flex-col gap-4" data-section="FAQs">
        <h2 class={h2}>FAQs</h2>
        {copy.faqs.map(f => (
          <div class="flex flex-col gap-1">
            <h3 class={h3}>{f.q}</h3>
            <p class="text-body-md text-on-surface-variant leading-relaxed" set:html={renderInline(f.a, ctx)} />
          </div>
        ))}
      </section>

      <section class="flex flex-col gap-3" data-section="Related">
        <h2 class={h2}>Related</h2>
        <ul class="flex flex-col gap-2 text-body-md">
          {copy.related.map(link => <li><a href={link.href} class="text-primary underline underline-offset-4 font-bold">{link.label}</a></li>)}
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>
