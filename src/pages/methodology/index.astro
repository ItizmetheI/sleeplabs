---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { toArticleBody } from '../../lib/schemaArticleBody';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import {
  METHODOLOGY_LEAD,
  METHODOLOGY_UPDATED,
  METHODOLOGY_SOURCES,
  METHODOLOGY_FIELDS,
  METHODOLOGY_OVERALL,
  METHODOLOGY_LIMITS,
  methodologyPlainSections,
} from '../../lib/methodologyContent';

const lastUpdated = METHODOLOGY_UPDATED;
const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const canonicalUrl = `${SITE_URL}/methodology/`;
const headline = 'How Mattress Inquirer Scores Mattresses';
const description = 'How Mattress Inquirer scores 55 mattresses from 24 brands on seven fields from 0 to 10, what earns a 10 versus a 7, and how Overall is calculated.';

const articleBody = toArticleBody(
  headline,
  BYLINE_DISCLOSURE,
  METHODOLOGY_LEAD,
  METHODOLOGY_UPDATED,
  methodologyPlainSections().map(section => [section.heading, ...section.paragraphs]),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": headline,
      "description": description,
      "articleBody": articleBody,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "datePublished": "2024-01-01",
      "dateModified": lastUpdated,
      "mainEntityOfPage": canonicalUrl
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Methodology", "item": canonicalUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title="How Mattress Inquirer Scores Mattresses | Methodology"
  description={description}
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/methodology.md`}
  lastUpdated={lastUpdated}
  jsonLd={jsonLd}
>
  <main class="max-w-3xl mx-auto px-margin-mobile md:px-margin-desktop py-16 relative z-10 w-full flex flex-col gap-12">
    <article class="contents" data-body data-page-type="methodology">

    <header class="flex flex-col gap-6">
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{headline}</h1>
      <Byline dateModified={lastUpdated} />
      <p class="text-body-lg text-on-surface-variant leading-relaxed">{METHODOLOGY_LEAD}</p>
      <p class="text-body-md text-on-surface-variant leading-relaxed">{METHODOLOGY_SOURCES}</p>
    </header>

    {METHODOLOGY_FIELDS.map(field => (
      <section class="flex flex-col gap-3">
        <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">{field.heading}</h2>
        <p class="text-body-md text-on-surface-variant leading-relaxed">{field.body}</p>
      </section>
    ))}

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">How Overall Is Calculated</h2>
      {METHODOLOGY_OVERALL.map(paragraph => (
        <p class="text-body-md text-on-surface-variant leading-relaxed">{paragraph}</p>
      ))}
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">What Scores Do Not Measure</h2>
      <p class="text-body-md text-on-surface-variant leading-relaxed">{METHODOLOGY_LIMITS}</p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">Related</h2>
      <ul class="flex flex-col gap-2 text-body-md">
        <li><a href="/reviews/" class="text-primary underline underline-offset-4 font-bold">Mattress Reviews and Scores (2026)</a></li>
        <li><a href="/best/overall/" class="text-primary underline underline-offset-4 font-bold">Best Mattress (2026)</a></li>
        <li><a href="/editorial-policy/" class="text-primary underline underline-offset-4 font-bold">Editorial Policy</a></li>
        <li><a href="/affiliate-disclosure/" class="text-primary underline underline-offset-4 font-bold">Affiliate Disclosure</a></li>
      </ul>
    </section>

  </article>
  </main>
</BaseLayout>
