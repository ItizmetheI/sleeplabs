---
import BaseLayout from '../../layouts/BaseLayout.astro';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const lastUpdated = "2026-10-11";
const canonicalUrl = `${SITE_URL}/affiliate-disclosure/`;
const description = 'Mattress Inquirer is reader-supported and may earn a commission when you buy through links on our site. Commissions never change our scores.';

// Fixed owner-supplied text. Never rewrite.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "name": "Affiliate Disclosure",
      "url": canonicalUrl,
      "description": description,
      "publisher": { "@type": "Organization", "name": "Mattress Inquirer", "url": SITE_URL }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Affiliate Disclosure", "item": canonicalUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title="Affiliate Disclosure | Mattress Inquirer"
  description={description}
  canonicalUrl={canonicalUrl}
  lastUpdated={lastUpdated}
  jsonLd={jsonLd}
>
  <main class="max-w-[760px] mx-auto px-margin-mobile md:px-0 py-16 relative z-10 flex flex-col gap-6">
    <article class="contents" data-body data-page-type="disclosure">
    <h1 class="text-headline-lg font-headline-lg text-primary font-bold">Affiliate Disclosure</h1>
    <p class="text-body-lg text-on-surface-variant leading-relaxed">Mattress Inquirer is reader-supported. When you buy a product through a link on our site, we may earn a commission at no extra cost to you.</p>
    <p class="text-body-lg text-on-surface-variant leading-relaxed">Commissions never change our scores. Every mattress is scored on the same seven-field scorecard.</p>
    <p class="text-body-lg text-on-surface-variant leading-relaxed">Questions? Email <a href="mailto:contact@mattressinquirer.com" class="text-primary underline underline-offset-4 font-bold">contact@mattressinquirer.com</a>.</p>
  </article>
  </main>
</BaseLayout>
