---
// Brands hub (owner template): lead with the brand count, then one card per brand
// (name linked, model count, highest Overall with any tie stated).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { allMattresses } from '../../data/mattresses';
import { toArticleBody } from '../../lib/schemaArticleBody';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { brandModels, brandSlug, scoreText } from '../../lib/pageData';
import { compareTieChain } from '../../lib/scoreFieldOrder';
import { h1For, reviewUrl } from '../../lib/ownerSite';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const DATE_MODIFIED = '2026-10-12';
const pageUrl = '/brands/';
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);

const names = (list: string[]) => (list.length < 2 ? list.join('') : `${list.slice(0, -1).join(', ')} and ${list.at(-1)}`);
const brands = [...new Set(allMattresses.map(m => m.brand))]
  .map(brand => {
    const models = brandModels(brand);
    const top = models.filter(m => m.scores.overall === models[0].scores.overall);
    return { brand, slug: brandSlug(brand), models, top };
  })
  .sort((x, y) => compareTieChain(x.models[0], y.models[0]));

const topLine = (b: (typeof brands)[number]) => b.top.length > 1
  ? `Highest ${b.brand} Overall: ${scoreText(b.top[0], 'overall')}/10, a tie between the ${names(b.top.map(m => m.name))}.`
  : `Highest ${b.brand} Overall: ${scoreText(b.top[0], 'overall')}/10, the ${b.top[0].name}.`;
const lead = `Mattress Inquirer scores ${allMattresses.length} mattresses from ${brands.length} brands on one seven-field scorecard. Each brand page lists every model we score, sorted by Overall, with links to its reviews and comparisons.`;
const description = `Mattress Inquirer scores ${allMattresses.length} mattresses from ${brands.length} brands on one seven-field scale. See each brand's model count and its highest Overall score, with ties stated.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#page`,
      "name": h1,
      "description": description,
      "url": canonicalUrl,
      "datePublished": DATE_MODIFIED,
      "dateModified": DATE_MODIFIED,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "text": toArticleBody(h1, BYLINE_DISCLOSURE, lead, brands.map(b => `${b.brand}: ${b.models.length} model${b.models.length === 1 ? '' : 's'}. ${topLine(b)}`), "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale."),
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": brands.map((b, i) => ({ "@type": "ListItem", "position": i + 1, "name": b.brand, "url": `${SITE_URL}/brands/${b.slug}/` })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": h1, "item": canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${h1}: ${brands.length} Brands, ${allMattresses.length} Models`}
  description={description}
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/brands.md`}
  lastUpdated={DATE_MODIFIED}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full">
    <article class="flex flex-col gap-8" data-body data-page-type="brands-hub">
      <header class="flex flex-col gap-4 max-w-3xl">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={DATE_MODIFIED} />
        <p class="text-body-lg text-on-surface leading-relaxed">{lead}</p>
      </header>
      <section class="flex flex-col gap-4" data-section="Brands" data-score-table>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {brands.map(b => (
            <li class="glass-panel rounded-lg border border-outline-variant/40 p-5 flex flex-col gap-2">
              <a href={`/brands/${b.slug}/`} class="block h-32 bg-white rounded-lg overflow-hidden"><img src={b.top[0].image} alt={`${b.top[0].name} mattress`} class="w-full h-full object-contain p-2" loading="lazy" /></a>
              <h2 class="text-title-lg font-bold"><a href={`/brands/${b.slug}/`} class="text-primary underline underline-offset-4">{b.brand}</a></h2>
              <p class="text-body-md text-on-surface-variant">{b.models.length} model{b.models.length === 1 ? '' : 's'} scored</p>
              <p class="text-body-md text-on-surface-variant">
                Highest Overall for the brand: {scoreText(b.top[0], 'overall')}/10,{' '}
                {b.top.length > 1 ? 'a tie between the ' : 'the '}
                {b.top.map((m, i) => (
                  <>{i > 0 && (i === b.top.length - 1 ? ' and ' : ', ')}<a href={reviewUrl(m.id)} class="text-primary underline underline-offset-4">{m.name}</a></>
                ))}.
              </p>
            </li>
          ))}
        </ul>
        <p class="text-body-sm text-on-surface-variant" data-score-line>Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.</p>
      </section>
    </article>
  </main>
</BaseLayout>
