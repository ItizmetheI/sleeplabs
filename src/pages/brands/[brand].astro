---
// Brand template (owner content instructions): summary, model table sorted by Overall,
// top-scoring model (ties stated), then links to every review and comparison for the brand.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import Prose from '../../components/Prose.astro';
import { allMattresses } from '../../data/mattresses';
import { comparisons } from '../../data/comparisons';
import { BRAND_COPY } from '../../content/brands';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody, articleTable } from '../../lib/schemaArticleBody';
import { brandModels, brandSlug, brandTopLead, getSpec, scoreText } from '../../lib/pageData';
import { h1For, plainInline, reviewUrl, firmnessShort, typeText, trialText, warrantyText } from '../../lib/ownerSite';

export function getStaticPaths() {
  return [...new Set(allMattresses.map(m => m.brand))].map(brand => ({
    params: { brand: brandSlug(brand) },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const slug = brandSlug(brand);
const copy = BRAND_COPY[slug];
if (!copy) throw new Error(`Missing brand copy for ${slug}`);

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const pageUrl = `/brands/${slug}/`;
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);
const ctx = `brand ${slug}`;

const models = brandModels(brand);
const ids = new Set(models.map(m => m.id));
const brandComparisons = comparisons.filter(c => ids.has(c.mattressAId) || ids.has(c.mattressBId));
const comparisonTitle = (c: (typeof comparisons)[number]) => h1For(`/comparison/${c.slug}/`);

// Top-scoring model sentence, generated so the score and any tie are always exact.
const topLead = brandTopLead(brand);

const rows: [string, string, string, string, string, string][] = models.map(m => {
  const spec = getSpec(m.id);
  return [m.name, `${scoreText(m, 'overall')}/10`, typeText(spec), firmnessShort(spec), trialText(spec), warrantyText(spec)];
});
const headers = ['Mattress', 'Overall', 'Type', 'Firmness', 'Trial', 'Warranty'];
const sTop = `Highest ${brand} Score`;
const sLinks = `${brand} Reviews and Comparisons`;
const title = `${h1}: ${models.length} Model${models.length === 1 ? '' : 's'} Scored`.length <= 60
  ? `${h1}: ${models.length} Model${models.length === 1 ? '' : 's'} Scored`
  : h1;

const articleBody = toArticleBody(
  h1,
  BYLINE_DISCLOSURE,
  `About ${brand}`, copy.summary.map(plainInline),
  articleTable(`${brand} Models We Score`, headers, rows),
  "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.",
  sTop, [plainInline(topLead), ...copy.topModel.map(plainInline)],
  sLinks,
  `Reviews: ${models.map(m => `${m.name} Review`).join('; ')}.`,
  brandComparisons.length ? `Comparisons: ${brandComparisons.map(comparisonTitle).join('; ')}.` : null,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": h1,
      "description": copy.metaDescription,
      "articleBody": articleBody,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "datePublished": copy.dateModified,
      "dateModified": copy.dateModified,
      "mainEntityOfPage": canonicalUrl,
      "about": { "@type": "Brand", "name": brand },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": h1For('/brands/'), "item": `${SITE_URL}/brands/` },
        { "@type": "ListItem", "position": 3, "name": h1, "item": canonicalUrl },
      ],
    },
  ],
};

const h2 = 'text-headline-md font-headline-md text-primary italic border-b border-outline-variant/30 pb-4';
const h3 = 'text-title-lg font-bold text-on-surface';
const tableWrap = 'w-full overflow-x-auto border border-outline-variant/40 rounded-lg';
const th = 'text-left px-4 py-3 font-bold text-on-surface bg-surface-container-low';
const td = 'px-4 py-3 text-on-surface-variant border-t border-outline-variant/30 align-top';
const linkCls = 'text-primary underline underline-offset-4 font-bold';
---

<BaseLayout
  title={title}
  description={copy.metaDescription}
  ogType="article"
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/brand-${slug}.md`}
  lastUpdated={copy.dateModified}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-16">
    <article class="flex flex-col gap-10" data-body data-page-type="brand" data-brand-models={String(models.length)}>
      <header class="flex flex-col gap-6 max-w-4xl">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={copy.dateModified} />
      </header>

      <section class="flex flex-col gap-3" data-section="About">
        <h2 class={h2}>About {brand}</h2>
        <Prose paragraphs={copy.summary} context={ctx} />
      </section>

      <section class="flex flex-col gap-3" data-section="Models" data-score-table>
        <h2 class={h2}>{brand} Models We Score</h2>
        <div class={tableWrap}>
          <table class="w-full text-body-md">
            <caption class="sr-only">Models sorted by Overall score</caption>
            <thead><tr>{headers.map(h => <th scope="col" class={th}>{h}</th>)}</tr></thead>
            <tbody>
              {models.map((m, i) => (
                <tr>
                  <th scope="row" class={`${th} font-normal`}>
                    <a href={reviewUrl(m.id)} class="flex items-center gap-3">
                      <img src={m.image} alt="" class="w-16 h-12 object-contain bg-white rounded shrink-0" loading="lazy" />
                      <span class={linkCls}>{m.name}</span>
                    </a>
                  </th>
                  {rows[i].slice(1).map(cell => <td class={td}>{cell}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-body-sm text-on-surface-variant" data-score-line>Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.</p>
      </section>

      <section class="flex flex-col gap-3" data-section="Top Model">
        <h2 class={h2}>{sTop}</h2>
        <a href={reviewUrl(models[0].id)} class="block glass-panel rounded-lg border border-outline-variant/40 overflow-hidden">
          <img src={models[0].heroImage || models[0].image} alt={`${models[0].name} mattress`} class="w-full h-56 md:h-64 object-contain bg-white p-3" loading="lazy" />
        </a>
        <Prose paragraphs={[topLead, ...copy.topModel]} context={ctx} />
      </section>

      <section class="flex flex-col gap-4" data-section="Links">
        <h2 class={h2}>{sLinks}</h2>
        <h3 class={h3}>Reviews</h3>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md">
          {models.map(m => <li><a href={reviewUrl(m.id)} class={linkCls}>{m.name} Review</a></li>)}
        </ul>
        {brandComparisons.length > 0 && (
          <>
            <h3 class={h3}>Comparisons</h3>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md">
              {brandComparisons.map(c => <li><a href={`/comparison/${c.slug}/`} class={linkCls}>{comparisonTitle(c)}</a></li>)}
            </ul>
          </>
        )}
      </section>
    </article>
  </main>
</BaseLayout>
