---
// Comparison template (owner content instructions): verdict first, fixed section order, two CTAs.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import PriceCta from '../../components/PriceCta.astro';
import Prose from '../../components/Prose.astro';
import ComparisonScoreChart from '../../components/ComparisonScoreChart.astro';
import { comparisons } from '../../data/comparisons';
import { COMPARISON_COPY } from '../../content/comparisons';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody, articleTable } from '../../lib/schemaArticleBody';
import { FIELD_LABEL } from '../../lib/ranking';
import { comparisonSeoTitle, getMattress, getSpec, leadsSentence, SCORECARD_FIELDS, scoreText, winnerLine } from '../../lib/pageData';
import {
  h1For, renderInline, plainInline, assertAllowedLink, reviewUrl,
  firmnessText, heightText, typeText, trialText, warrantyText, PRICE_LABEL, SEE_PRICE,
} from '../../lib/ownerSite';

export function getStaticPaths() {
  // MI_CMP limits a local QA build to listed slugs while copy is in progress; release builds never set it.
  const only = process.env.MI_CMP?.split(',');
  return comparisons
    .filter(c => !only || only.includes(c.slug))
    .map(c => ({ params: { slug: c.slug }, props: { comparison: c } }));
}

const { comparison } = Astro.props;
const copy = COMPARISON_COPY[comparison.slug];
if (!copy) throw new Error(`Missing comparison copy for ${comparison.slug}`);
if (copy.faqs.length < 4 || copy.faqs.length > 6) throw new Error(`${comparison.slug}: needs 4 to 6 FAQs.`);

const a = getMattress(comparison.mattressAId);
const b = getMattress(comparison.mattressBId);
const specA = getSpec(a.id);
const specB = getSpec(b.id);
const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const pageUrl = `/comparison/${comparison.slug}/`;
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);
const ctx = `comparison ${comparison.slug}`;
copy.related.forEach(link => assertAllowedLink(link.href, `${ctx} related`));

// Quick Verdict lead: the winner by Overall, then the owner's fixed leads sentence.
const verdictLead = `${winnerLine(a, b, m => `[${m.name}](${reviewUrl(m.id)})`)} ${leadsSentence(a, b)}`;

const sideRows: [string, string, string][] = [
  ...SCORECARD_FIELDS.map(k => [FIELD_LABEL[k], `${scoreText(a, k)}/10`, `${scoreText(b, k)}/10`] as [string, string, string]),
  ['Type', typeText(specA), typeText(specB)],
  ['Firmness', firmnessText(specA), firmnessText(specB)],
  ['Height', heightText(specA), heightText(specB)],
  [PRICE_LABEL, SEE_PRICE, SEE_PRICE],
  ['Trial', trialText(specA), trialText(specB)],
  ['Warranty', warrantyText(specA), warrantyText(specB)],
];

const sections: [string, string[]][] = [
  ['Feel and Firmness', copy.feel],
  ['Construction', copy.construction],
  ['Edge Support', copy.edgeSupport],
  ['Motion Transfer', copy.motionTransfer],
  ['Cooling', copy.cooling],
  ['Response', copy.response],
  ['Value and Policies', copy.valuePolicies],
];
const buyHeading = `Who Should Buy the ${a.name} / Who Should Buy the ${b.name}`;
const plain = (items: string[]) => items.map(plainInline);

const articleBody = toArticleBody(
  h1,
  BYLINE_DISCLOSURE,
  'Quick Verdict', plainInline(verdictLead), plainInline(copy.quickVerdict),
  articleTable('Side by Side', ['Field', a.name, b.name], sideRows),
  "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.",
  ...sections.flatMap(([heading, paras]) => [heading, plain(paras)]),
  buyHeading,
  `Who Should Buy the ${a.name}: ${plain(copy.buyA).join(' ')}`,
  `Who Should Buy the ${b.name}: ${plain(copy.buyB).join(' ')}`,
  'FAQs', copy.faqs.map(f => [f.q, plainInline(f.a)]),
);

const product = (m: typeof a) => ({
  "@type": "Product",
  "@id": `${SITE_URL}${reviewUrl(m.id)}#product`,
  "name": m.name,
  "brand": { "@type": "Brand", "name": m.brand },
  "url": `${SITE_URL}${reviewUrl(m.id)}`,
});

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonicalUrl}#article`,
      "headline": h1,
      "description": copy.metaDescription,
      "articleBody": articleBody,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "datePublished": copy.dateModified,
      "dateModified": copy.dateModified,
      "mainEntityOfPage": canonicalUrl,
      "about": [{ "@id": `${SITE_URL}${reviewUrl(a.id)}#product` }, { "@id": `${SITE_URL}${reviewUrl(b.id)}#product` }]
    },
    product(a),
    product(b),
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "Mattress Comparisons (2026)", "item": `${SITE_URL}/comparison/` },
        { "@type": "ListItem", "position": 3, "name": h1, "item": canonicalUrl }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": copy.faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": plainInline(f.a) } }))
    }
  ]
};

const h2 = 'text-headline-md font-headline-md text-primary italic border-b border-outline-variant/30 pb-4';
const h3 = 'text-title-lg font-bold text-on-surface';
const tableWrap = 'w-full overflow-x-auto border border-outline-variant/40 rounded-lg';
const th = 'text-left px-4 py-3 font-bold text-on-surface bg-surface-container-low';
const td = 'px-4 py-3 text-on-surface-variant border-t border-outline-variant/30 align-top';
---

<BaseLayout
  title={comparisonSeoTitle(a, b)}
  description={copy.metaDescription}
  ogType="article"
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/comparison-${comparison.slug}.md`}
  lastUpdated={copy.dateModified}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full flex flex-col gap-16">
    <article class="flex flex-col gap-10" data-body data-page-type="comparison">
      <header class="flex flex-col gap-6 items-center text-center max-w-4xl mx-auto w-full">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={copy.dateModified} />
        <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 glass-panel rounded-lg border border-outline-variant/40 p-4">
          <a href={reviewUrl(a.id)} class="flex flex-col items-center gap-2 text-center group">
            <img src={a.heroImage || a.image} alt={`${a.name} mattress`} class="w-full h-36 md:h-44 object-contain bg-white rounded-lg p-2" loading="eager" />
            <span class="font-bold text-primary group-hover:text-secondary">{a.name}</span>
          </a>
          <span class="text-label-lg font-bold text-on-surface-variant italic">VS</span>
          <a href={reviewUrl(b.id)} class="flex flex-col items-center gap-2 text-center group">
            <img src={b.heroImage || b.image} alt={`${b.name} mattress`} class="w-full h-36 md:h-44 object-contain bg-white rounded-lg p-2" loading="eager" />
            <span class="font-bold text-primary group-hover:text-secondary">{b.name}</span>
          </a>
        </div>
      </header>

      <section class="flex flex-col gap-3" data-section="Quick Verdict">
        <h2 class={h2}>Quick Verdict</h2>
        <p class="text-body-lg text-on-surface leading-relaxed" data-verdict-lead set:html={renderInline(verdictLead, ctx)} />
        <Prose paragraphs={[copy.quickVerdict]} context={ctx} />
      </section>

      <section class="flex flex-col gap-3" data-section="Side by Side" data-score-table>
        <h2 class={h2}>Side by Side</h2>
        <ComparisonScoreChart mattressA={a} mattressB={b} />
        <div class={tableWrap}>
          <table class="w-full text-body-md">
            <caption class="sr-only">Scores and specs side by side</caption>
            <thead><tr><th scope="col" class={th}>Field</th><th scope="col" class={th}><a href={reviewUrl(a.id)} class="text-primary underline underline-offset-4">{a.name}</a></th><th scope="col" class={th}><a href={reviewUrl(b.id)} class="text-primary underline underline-offset-4">{b.name}</a></th></tr></thead>
            <tbody>
              {sideRows.map(([label, va, vb]) => <tr><th scope="row" class={`${th} font-normal`}>{label}</th><td class={td}>{va === SEE_PRICE ? <PriceCta mattress={a} pageUrl={pageUrl} variant="text" label={SEE_PRICE} /> : va}</td><td class={td}>{vb === SEE_PRICE ? <PriceCta mattress={b} pageUrl={pageUrl} variant="text" label={SEE_PRICE} /> : vb}</td></tr>)}
            </tbody>
          </table>
        </div>
        <p class="text-body-sm text-on-surface-variant" data-score-line>Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.</p>
      </section>

      {sections.map(([heading, paras]) => (
        <section class="flex flex-col gap-3" data-section={heading}>
          <h2 class={h2}>{heading}</h2>
          <Prose paragraphs={paras} context={ctx} />
        </section>
      ))}

      <section class="flex flex-col gap-4" data-section="Who Should Buy">
        <h2 class={h2}>{buyHeading}</h2>
        <h3 class={h3}>Who Should Buy the {a.name}</h3>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
          {copy.buyA.map(item => <li set:html={renderInline(item, ctx)} />)}
        </ul>
        <h3 class={h3}>Who Should Buy the {b.name}</h3>
        <ul class="list-disc pl-6 flex flex-col gap-2 text-body-md text-on-surface-variant">
          {copy.buyB.map(item => <li set:html={renderInline(item, ctx)} />)}
        </ul>
      </section>

      <section class="flex flex-col gap-4" data-section="FAQs">
        <h2 class={h2}>FAQs</h2>
        {copy.faqs.map(f => (
          <div class="flex flex-col gap-1">
            <h3 class={h3}>{f.q}</h3>
            <p class="text-body-md text-on-surface-variant leading-relaxed" set:html={renderInline(f.a, ctx)} />
          </div>
        ))}
      </section>

      <div class="flex flex-wrap gap-4" data-ctas>
        <PriceCta mattress={a} pageUrl={pageUrl} />
        <PriceCta mattress={b} pageUrl={pageUrl} />
      </div>

      <section class="flex flex-col gap-3" data-section="Related">
        <h2 class={h2}>Related</h2>
        <ul class="flex flex-col gap-2 text-body-md">
          {copy.related.map(link => <li><a href={link.href} class="text-primary underline underline-offset-4 font-bold">{link.label}</a></li>)}
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>
