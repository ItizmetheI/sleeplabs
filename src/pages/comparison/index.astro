---
// Comparisons hub (owner template): lead sentence, then one card per comparison
// (title linked, the Quick Verdict winner sentence).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { comparisons } from '../../data/comparisons';
import { toArticleBody } from '../../lib/schemaArticleBody';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { getMattress, winnerLine } from '../../lib/pageData';
import { h1For, renderInline, reviewUrl } from '../../lib/ownerSite';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const DATE_MODIFIED = '2026-10-12';
const pageUrl = '/comparison/';
const canonicalUrl = `${SITE_URL}${pageUrl}`;
const h1 = h1For(pageUrl);

const cards = comparisons.map(c => {
  const a = getMattress(c.mattressAId);
  const b = getMattress(c.mattressBId);
  return { slug: c.slug, title: h1For(`/comparison/${c.slug}/`), verdict: winnerLine(a, b), linked: winnerLine(a, b, m => `[${m.name}](${reviewUrl(m.id)})`), a, b };
});
const brandCount = new Set(comparisons.flatMap(c => [getMattress(c.mattressAId).brand, getMattress(c.mattressBId).brand])).size;
const lead = `${cards.length} head-to-head comparisons across ${brandCount} brands, each scored on the same seven fields. Every card gives the winner by Overall score; open a comparison for the full side by side table and verdict.`;
const description = `${cards.length} mattress comparisons across ${brandCount} brands, each scored on the same seven fields, with the Overall winner, a side by side table and a verdict.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonicalUrl}#page`,
      "name": h1,
      "description": description,
      "url": canonicalUrl,
      "datePublished": DATE_MODIFIED,
      "dateModified": DATE_MODIFIED,
      "author": { "@type": "Organization", "@id": `${SITE_URL}/about/#editorial-team`, "name": "Mattress Inquirer Editorial Team", "url": `${SITE_URL}/about/#editorial-team` },
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL },
      "text": toArticleBody(h1, BYLINE_DISCLOSURE, lead, cards.map(c => `${c.title}: ${c.verdict}`), "Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale."),
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": cards.map((c, i) => ({ "@type": "ListItem", "position": i + 1, "name": c.title, "url": `${SITE_URL}/comparison/${c.slug}/` })),
      },
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": h1, "item": canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout
  title={`${h1}: ${cards.length} Head-to-Head Scorecards`}
  description={description}
  canonicalUrl={canonicalUrl}
  machineReadableUrl={`${SITE_URL}/llms/comparisons.md`}
  lastUpdated={DATE_MODIFIED}
  jsonLd={jsonLd}
>
  <main class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 relative z-10 w-full">
    <article class="flex flex-col gap-8" data-body data-page-type="comparisons-hub">
      <header class="flex flex-col gap-4 max-w-3xl">
        <h1 class="text-headline-lg font-headline-lg text-primary font-bold">{h1}</h1>
        <Byline dateModified={DATE_MODIFIED} />
        <p class="text-body-lg text-on-surface leading-relaxed">{lead}</p>
      </header>
      <section class="flex flex-col gap-4" data-section="Comparisons" data-score-table>
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {cards.map(c => (
            <li class="glass-panel rounded-lg border border-outline-variant/40 p-5 flex flex-col gap-2">
              <a href={`/comparison/${c.slug}/`} class="flex items-center gap-2">
                <img src={c.a.image} alt={`${c.a.name} mattress`} class="w-1/2 h-24 object-contain bg-white rounded p-1" loading="lazy" />
                <span class="text-body-sm font-bold text-on-surface-variant italic">vs</span>
                <img src={c.b.image} alt={`${c.b.name} mattress`} class="w-1/2 h-24 object-contain bg-white rounded p-1" loading="lazy" />
              </a>
              <h2 class="text-title-lg font-bold"><a href={`/comparison/${c.slug}/`} class="text-primary underline underline-offset-4">{c.title}</a></h2>
              <p class="text-body-md text-on-surface-variant" set:html={renderInline(c.linked, 'comparisons hub')} />
            </li>
          ))}
        </ul>
        <p class="text-body-sm text-on-surface-variant" data-score-line>Scores are Mattress Inquirer's editorial ratings on a 0 to 10 scale.</p>
      </section>
    </article>
  </main>
</BaseLayout>
