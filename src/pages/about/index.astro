---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Byline from '../../components/Byline.astro';
import { BYLINE_DISCLOSURE } from '../../lib/disclosure';
import { toArticleBody } from '../../lib/schemaArticleBody';
import { MODEL_COUNT, BRAND_COUNT } from '../../lib/methodologyContent';
import { BEST_PAGE_CONFIGS } from '../../lib/ranking';
import { comparisons } from '../../data/comparisons';

const SITE_URL = import.meta.env.SITE_URL || 'https://mattressinquirer.ahmedbarkat1067.workers.dev';
const CONTACT_EMAIL = 'contact@mattressinquirer.com';
const lastUpdated = "2026-10-11";
const canonicalUrl = `${SITE_URL}/about/`;

const lead = `Mattress Inquirer is a scorecard database of ${MODEL_COUNT} mattresses from ${BRAND_COUNT} brands. Every model is scored on the same seven fields, so any two mattresses can be compared side by side.`;
const sections = [
  {
    heading: 'What We Score',
    paragraphs: [
      'The seven fields are Overall, Value, Edge Support, Trial Period, Response Time, Motion Transfer, and Cooling & Breathability. Each field uses a 0 to 10 scale.',
      'Overall is the average of the other six, shown to one decimal. The methodology page explains what earns a 10 and what earns a 7 in each field.',
    ],
  },
  {
    heading: 'What We Publish',
    paragraphs: [
      'Reviews, head-to-head comparisons, ranked category pages, and brand pages all draw on the same scorecard. Specs come from each brand\'s official product page, and we ask readers to confirm current terms there.',
      `The site has ${MODEL_COUNT} reviews, ${BEST_PAGE_CONFIGS.length} ranked category pages and ${comparisons.length} head-to-head comparisons, each built from the same seven fields.`,
    ],
  },
  {
    heading: 'Our Editorial Team',
    id: 'editorial-team',
    paragraphs: [
      'Every page is published under the Mattress Inquirer Editorial Team byline. The team maintains the scorecard, writes the reviews and comparisons, and corrects a page when a brand changes a product or policy.',
      'Mattress Inquirer is reader-supported. The affiliate disclosure explains how links on this site work.',
    ],
  },
  {
    heading: 'Contact',
    paragraphs: [`Send corrections, product updates, and questions to ${CONTACT_EMAIL}.`],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "name": "About Mattress Inquirer",
      "url": canonicalUrl,
      "description": lead,
      "text": toArticleBody('About Mattress Inquirer', BYLINE_DISCLOSURE, lead, sections.map(s => [s.heading, ...s.paragraphs])),
      "dateModified": lastUpdated,
      "publisher": { "@type": "Organization", "@id": `${SITE_URL}/#organization`, "name": "Mattress Inquirer", "url": SITE_URL, "email": CONTACT_EMAIL }
    },
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/about/#editorial-team`,
      "name": "Mattress Inquirer Editorial Team",
      "url": `${SITE_URL}/about/#editorial-team`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": `${SITE_URL}/` },
        { "@type": "ListItem", "position": 2, "name": "About", "item": canonicalUrl }
      ]
    }
  ]
};
---

<BaseLayout
  title={`About Mattress Inquirer | ${MODEL_COUNT} Mattresses, ${BRAND_COUNT} Brands`}
  description={`Mattress Inquirer is a scorecard database of ${MODEL_COUNT} mattresses from ${BRAND_COUNT} brands, each scored on the same seven fields from 0 to 10 and easy to compare.`}
  canonicalUrl={canonicalUrl}
  lastUpdated={lastUpdated}
  jsonLd={jsonLd}
>
  <main class="max-w-[760px] mx-auto px-margin-mobile md:px-0 py-16 relative z-10 flex flex-col gap-12">
    <article class="contents" data-body data-page-type="about">

    <header class="flex flex-col gap-6">
      <h1 class="text-headline-lg font-headline-lg text-primary font-bold">About Mattress Inquirer</h1>
      <Byline dateModified={lastUpdated} />
      <p class="text-body-lg text-on-surface-variant leading-relaxed">{lead}</p>
    </header>

    {sections.map(section => (
      <section id={section.id} class="flex flex-col gap-3">
        <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">{section.heading}</h2>
        {section.paragraphs.map(paragraph => (
          <p class="text-body-md text-on-surface-variant leading-relaxed">{paragraph}</p>
        ))}
      </section>
    ))}

    <section class="flex flex-col gap-3">
      <h2 class="text-headline-md font-headline-md text-primary border-b border-outline-variant/30 pb-3">Related</h2>
      <ul class="flex flex-col gap-2 text-body-md">
        <li><a href="/methodology/" class="text-primary underline underline-offset-4 font-bold">How Mattress Inquirer Scores Mattresses</a></li>
        <li><a href="/reviews/" class="text-primary underline underline-offset-4 font-bold">Mattress Reviews and Scores (2026)</a></li>
        <li><a href="/editorial-policy/" class="text-primary underline underline-offset-4 font-bold">Editorial Policy</a></li>
        <li><a href="/affiliate-disclosure/" class="text-primary underline underline-offset-4 font-bold">Affiliate Disclosure</a></li>
        <li><a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline underline-offset-4 font-bold">{CONTACT_EMAIL}</a></li>
      </ul>
    </section>

  </article>
  </main>
</BaseLayout>
