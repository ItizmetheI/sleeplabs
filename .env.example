# Environment variables for Mattress Inquirer
#
# SITE_URL drives every canonical, sitemap entry, robots sitemap line, JSON-LD URL,
# and generated /llms/ document. When unset the build falls back to the Workers
# preview origin below.
#
# Preview fallback: https://mattressinquirer.ahmedbarkat1067.workers.dev
# SITE_URL=https://www.confirmed-domain.example

# --- Release gating (see AHMED-RUNBOOK.md steps 4-6) ---------------------------
#
# These FAIL CLOSED. With none of them set, the build is a non-indexable preview:
# every page emits "noindex, nofollow, noarchive" and robots.txt returns
# "Disallow: /". Production indexing is opt-in and must be verified with
# `npm run qa:release-config` before `npm run build`.

# preview (default) | production
# PUBLIC_INDEXING_MODE=preview

# YYYY-MM-DD. Articles dated after this stay noindex, are labelled "scheduled",
# and are excluded from the sitemap, pagination, and category/tag archives.
# Defaults to the build date, which is NOT deterministic — set it for a release.
# PUBLIC_CONTENT_CUTOFF_DATE=2026-08-25

# Monitored public editorial/privacy mailbox. Required for production indexing.
# When unset, About and Privacy state that no contact is published yet.
# PUBLIC_CONTACT_EMAIL=editorial@confirmed-domain.example

# Set to true only after Firas records a dated decision naming the approved
# public brand and the exact HTTPS production hostname.
# PUBLIC_BRAND_APPROVED=false

# Set to true only after the legal owner/operator, brand affiliations, and every
# form of consideration are certified. Until then the independence and
# no-commission wording is withheld sitewide, per
# EVIDENCE-AND-CLAIMS-DISPOSITION.md.
# PUBLIC_DISCLOSURE_APPROVED=false

ADMIN_SECRET=
